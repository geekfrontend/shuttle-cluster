# Neon — connection string pooled (host berakhiran -pooler) untuk runtime aplikasi
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Neon — connection string langsung (non-pooled) untuk prisma migrate / studio / seed
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Minimal 32 karakter acak, mis. `openssl rand -base64 48`
SESSION_SECRET="IaAKBKsk9vm1jN2KNwYjo1K9DMd1aGeoGF/1N6ag2RSdnhdBRjH9JE2/nmpHzgr8"

# Hanya untuk `bun run db:seed` (branch dev)
ADMIN_EMAIL="admin@shuttle-cluster.example"
ADMIN_PASSWORD="Admin123!"

# URL publik untuk sitemap, mis. https://shuttle-cluster.vercel.app
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Dokumentasi API (Scalar di /api/docs). Default: aktif di development, mati di production.
